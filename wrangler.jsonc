// Publication sur Cloudflare Workers (adresse learn-space.<compte>.workers.dev), des fichiers statiques,
// plus un petit code pour la racine « / ». Le dossier _site/ est produit par « node outils/site-public.js »
// (commande de construction) ; il ne contient que les fichiers publics (ni serveur/, ni docs/, ni tests/).
// html_handling « none » : tp.html reste tp.html (pas de redirection vers /tp), sinon le service worker
// ne peut pas mettre les pages en cache et l'application ne marche pas hors ligne. Avec « none », la
// racine « / » ne trouve plus index.html : outils/cloudflare-worker.js s'en charge.
{
  "name": "learn-space",
  "compatibility_date": "2025-09-01",
  "main": "outils/cloudflare-worker.js",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
